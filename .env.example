# =====================================================
# IrengCloud Universal API — Environment Variables
# Copy file ini ke `.env` lalu isi nilainya:
#   cp .env.example .env
# JANGAN commit `.env` — sudah di .gitignore & .dockerignore.
# =====================================================

# ---------- Server ----------
# Port HTTP server (default 8410)
PORT=8410
# production | development | test
NODE_ENV=production
# Domain publik tempat API diakses (dipakai sebagai base URL pada response upload)
PUBLIC_DOMAIN=https://apiku.irengcloud.com

# ---------- Scraper ----------
# Delay antar request scraper dalam milidetik (default 100)
DELAY_MS=100

# ---------- Cloudflare R2 (Upload) ----------
# Diperlukan oleh endpoint upload /api/v1/upload
# Account ID bisa dilihat di dashboard Cloudflare R2 → account ID
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Domain publik untuk akses file (bisa custom domain R2 atau r2.dev)
R2_PUBLIC_DOMAIN=https://s3.ireng.uk/
# Nama bucket R2 (default kanata)
R2_BUCKET_NAME=kanata

# ---------- Anime ----------
# Base URL situs animasu (kalau domainnya ganti / halaman down)
ANIMASU_BASE_URL=https://animasu.love